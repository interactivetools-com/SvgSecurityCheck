{
    "name": "itools/svgsecuritycheck",
    "description": "Allowlist check for uploaded SVG files: rejects any that could run script, load an outside resource, or hang a renderer, even when opened outside an <img> tag, and never rewrites a file it accepts",
    "keywords": ["php", "svg", "svg-upload", "svg-security", "file-upload", "image-upload", "upload-validation", "svg-validator", "validator", "allowlist", "security", "xss", "svg-xss", "stored-xss", "xxe", "entity-expansion", "svg-sanitizer", "xmlreader", "libxml"],
    "type": "library",
    "homepage": "https://github.com/interactivetools-com/SvgSecurityCheck",
    "license": "MIT",
    "readme": "README.md",
    "support": {
        "issues": "https://github.com/interactivetools-com/SvgSecurityCheck/issues",
        "source": "https://github.com/interactivetools-com/SvgSecurityCheck"
    },
    "authors": [
        {
            "name": "interactivetools.com",
            "homepage": "https://interactivetools.com/"
        }
    ],
    "autoload": {
        "psr-4": {
            "Itools\\SvgSecurityCheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Itools\\SvgSecurityCheck\\Tests\\": "tests/",
            "Itools\\Standards\\": "tests/Integration/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "require": {
        "php": "^8.1",
        "ext-libxml": "*",
        "ext-xmlreader": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "coverage": "Run the test suite with a line-coverage report (requires Xdebug)"
    }
}
